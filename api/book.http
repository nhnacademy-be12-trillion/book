### 변수 설정
@host = http://localhost:10413
@bookId = 1
@memberId = 1
# 테스트할 카테고리 ID
@categoryId = 1
# 테스트 후 생성된 리뷰 ID
@targetReviewId = 1

###
# 1. [도서 목록 조회] (Read - List)
GET {{host}}/api/books?page=0&size=20

###
# 2. [도서 등록] (Create)
# BookController는 기존 코드 기반으로 name="book" 유지
POST {{host}}/api/books
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="book"
Content-Type: application/json

{
  "isbn": "9781111222233",
  "bookName": "[HTTP Client] 새로 등록한 책",
  "bookDescription": "IntelliJ에서 등록 테스트",
  "bookPublisher": "IntelliJ 출판사",
  "bookPublicationDate": "2025-11-19",
  "bookIndex": "목차: IntelliJ",
  "bookPackaging": true,
  "bookState": "ON_SALE",
  "bookStock": 100,
  "bookRegularPrice": 50000,
  "bookSalePrice": 50000,
  "bookImage": "/images/intellij_test.png",
  "categoryIdList": [1]
}
--boundary
Content-Disposition: form-data; name="file"; filename="test.txt"
Content-Type: text/plain

# (이미지 파일이 없으면 빈 파일 전송)
# < /Users/사용자/Desktop/image.png
--boundary--


###
# 3. [도서 수정] (Update - PUT 매핑)
PUT {{host}}/api/books/2
Content-Type: application/json

{
  "discountRate": 10.0
}

###
# 4. [도서 삭제] (Delete)
DELETE {{host}}/api/books/{{bookId}}

###
# 5. [리뷰 작성] (이미지 첨부 테스트)
POST {{host}}/api/reviews
Content-Type: multipart/form-data; boundary=boundary
X-Member-Id: {{memberId}}

--boundary
Content-Disposition: form-data; name="request"
Content-Type: application/json

{
  "bookId": {{bookId}},
  "reviewRate": 5,
  "reviewContents": "프로젝트 내의 기본 이미지를 업로드합니다!"
}

--boundary
Content-Disposition: form-data; name="images"; filename="default_book.png"
Content-Type: image/png

< /Users/chosun-nhn50/Desktop/book/src/main/resources/static/images/default_book.png
--boundary
Content-Disposition: form-data; name="images"; filename="book1.jpg"
Content-Type: image/jpg

< /Users/chosun-nhn50/Desktop/book/src/main/resources/static/images/book1.jpg
--boundary
Content-Disposition: form-data; name="images"; filename="book2.png"
Content-Type: image/png

< /Users/chosun-nhn50/Desktop/book/src/main/resources/static/images/book2.png
--boundary--

###
# 6. [리뷰 목록 조회] (특정 도서)
GET {{host}}/api/books/{{bookId}}/reviews
Accept: application/json

###
# 7. [리뷰 수정] (소유자 성공 케이스)
# ★수정됨: Header가 X-Member-Id로 변경됨
PUT {{host}}/api/reviews/{{targetReviewId}}
Content-Type: application/json
X-Member-Id: {{memberId}}

{
  "reviewRate": 3,
  "reviewContents": "수정된 내용입니다. 평점을 3점으로 하향 조정."
}

###
# 8. [도서 상세 조회] (평균 평점 업데이트 확인)
GET {{host}}/api/books/{{bookId}}
Accept: application/json

###
# 9. [리뷰 수정 실패] (타인 실패 케이스)
# ★수정됨: Header가 X-Member-Id로 변경됨
PUT {{host}}/api/reviews/{{targetReviewId}}
Content-Type: application/json
X-Member-Id: 99

{
  "reviewRate": 1,
  "reviewContents": "타인 수정 시도입니다."
}

###
# 18. [리뷰 목록 조회] (특정 멤버가 작성한 리뷰)
# 페이징 파라미터(?page=0&size=10)를 포함했습니다.
GET {{host}}/api/mypage/reviews
X-Member-Id: 1
Accept: application/json

###
# 10. [알라딘 API 목차 증강]
POST {{host}}/api/books/toc/augment

###
# 11. [위시리스트] (찜하기 / 찜취소 토글)
# 결과: true(찜성공), false(찜취소)
POST {{host}}/api/wishlists/{{bookId}}
Content-Type: application/json
X-Member-Id: {{memberId}}

###
# 11-1. [위시리스트 목록 조회]
# 기대값: 방금 찜한 책 정보 + imageUrl이 정상적으로 매핑되어야 함
GET {{host}}/api/wishlists
Content-Type: application/json
X-Member-Id: {{memberId}}

###
# 12. [주문 발생 - 재고 차감]
POST {{host}}/api/books/{{bookId}}/deduct-stock
Content-Type: application/json

{
  "quantity": 1
}

###
# 13. [도서에 등록된 파일 조회]
GET {{host}}/api/files/1
Accept: application/json

###
# 14. [도서 이미지 등록]
POST {{host}}/api/files/books/{{bookId}}/image
Content-Type: application/json

{
  "imageUrl": "https://image.aladin.co.kr/product/33461/33/cover/K182938865_1.jpg"
}

###
# 15. [관리자 기능]
POST {{host}}/admin/refresh-images
Content-Type: application/json

###
# 16. [MinIO 테스트 버킷 삭제]
DELETE http://localhost:10413/test/minio/bucket

###
# 17. [가격 데이터 보정]
POST {{host}}/api/admin/migration/price/fix


### ==========================================================
### [NEW] 메인 페이지 섹션별 조회 테스트
### ==========================================================

###
# 19. [메인] 베스트셀러 조회 (조회수 기준 Top 5)
# 기대결과: viewCount가 높은 순서대로 최대 5권 반환
GET {{host}}/api/books/popularBooks
Accept: application/json

###
# 20. [메인] 카테고리별 신간 조회 (출판일 기준 Top 5)
# 기대결과: 해당 카테고리에 속한 책 중 최신순으로 5권 반환
GET {{host}}/api/books/categories/30/top
Accept: application/json

###
# 21. [데이터 세팅] 조회수 증가시키기 (베스트셀러 순위 조작용)
# 이 API를 bookId를 바꿔가며 여러 번 호출하면 베스트셀러 순위가 바뀝니다.
GET {{host}}/api/books/99
Accept: application/json

###
# 18. 베스트 셀러 테스트
GET {{host}}/books/best-sellers